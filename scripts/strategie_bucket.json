{
  "Version" : "2012-10-17",
  "Id" : "policy01",
  "Statement" : [
    {
      "Effect" : "Allow",
      "Principal" : {
        "AWS" : "*"
      },
      "Action" : "S3:GetObjet",
      "Ressource" : "arn:aws:S3:::programme-ruben/python/*"
    },
    {
      "Effect" : "Allow",
      "Principal" : {
        "AWS": "arn:aws:iam::Account-ID:user/ruben"
      },
      "Action" : [
        "S3:PutObjet",
        "S3:DeleteObjet"
      ],
      "Ressource" : "arn:aws:S3:::programme-ruben/*"
    }
  ]
}